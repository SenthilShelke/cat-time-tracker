{
  "name": "cat-time-tracker",
  "version": "0.1.1",
  "description": "A cat that lives in your menu bar and tracks your working hours. Click the cat to start/stop the clock.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "time-tracking",
    "electron",
    "productivity",
    "freelance",
    "invoice",
    "cat"
  ],
  "license": "MIT",
  "author": "Senthil Shelke",
  "build": {
    "appId": "com.senthilshelke.cat-time-tracker",
    "productName": "Cat Time Tracker",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "SenthilShelke",
      "repo": "cat-time-tracker",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  }
}
